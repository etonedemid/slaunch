diff --git a/loader/src/arena_core.h b/loader/src/arena_core.h
new file mode 100644
index 0000000..c49bdb5
--- /dev/null
+++ b/loader/src/arena_core.h
@@ -0,0 +1,118 @@
+/* First-fit allocator over one address range, for the big allocations (see
+   main.cpp). Not thread-safe; callers hold the lock. No libnx in here, so
+   scripts/qext/test_arena.cpp can run it on a PC. */
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+namespace arena {
+
+struct Free { size_t size; Free *next; };
+struct Head { size_t size; size_t magic; };   /* just before the payload, block starts here */
+constexpr size_t kMagic = 0x4152454E41424C4BULL;
+constexpr size_t kMinBlock = sizeof(Head) + 16;
+
+inline Free *g_free = nullptr;   /* sorted by address */
+
+inline void Insert(char *start, size_t size)
+{
+    Free *prev = nullptr, *cur = g_free;
+    while (cur && (char *)cur < start) {
+        prev = cur;
+        cur = cur->next;
+    }
+    Free *f = (Free *)start;
+    f->size = size;
+    f->next = cur;
+    if (cur && start + size == (char *)cur) {
+        f->size += cur->size;
+        f->next = cur->next;
+    }
+    if (prev && (char *)prev + prev->size == start) {
+        prev->size += f->size;
+        prev->next = f->next;
+    } else if (prev) {
+        prev->next = f;
+    } else {
+        g_free = f;
+    }
+}
+
+inline void *Alloc(size_t n, size_t align)
+{
+    if (align < 16)
+        align = 16;
+    if (n > SIZE_MAX / 2)
+        return nullptr;
+    n = (n + 15) & ~(size_t)15;
+    Free *prev = nullptr;
+    for (Free *f = g_free; f; prev = f, f = f->next) {
+        char *start = (char *)f;
+        char *limit = start + f->size;
+        char *p = (char *)(((uintptr_t)start + sizeof(Head) + align - 1) & ~(uintptr_t)(align - 1));
+        /* A gap in front must be able to hold a free block of its own. */
+        if (p - sizeof(Head) != start && (size_t)(p - sizeof(Head) - start) < kMinBlock)
+            p += align;
+        char *end = p + n;
+        if (end > limit)
+            continue;
+        if ((size_t)(limit - end) < kMinBlock)
+            end = limit;   /* a tail too small to track stays with this block */
+        Free *next = f->next;
+        if (prev)
+            prev->next = next;
+        else
+            g_free = next;
+        char *block = p - sizeof(Head);
+        if (block != start)
+            Insert(start, (size_t)(block - start));
+        if (end != limit)
+            Insert(end, (size_t)(limit - end));
+        Head *h = (Head *)block;
+        h->size = (size_t)(end - block);
+        h->magic = kMagic;
+        return p;
+    }
+    return nullptr;
+}
+
+inline size_t Usable(void *p)
+{
+    Head *h = (Head *)p - 1;
+    return h->size - sizeof(Head);
+}
+
+inline void Release(void *p)
+{
+    Head *h = (Head *)p - 1;
+    h->magic = 0;
+    Insert((char *)h, h->size);
+}
+
+/* Bytes free. */
+inline size_t FreeBytes()
+{
+    size_t n = 0;
+    for (Free *f = g_free; f; f = f->next)
+        n += f->size;
+    return n;
+}
+
+/* If the last free block runs up to `end`, take it off the list and return where
+   it starts; otherwise return `end`. That is how far the range can shrink. */
+inline char *TrimEnd(char *end)
+{
+    Free *prev = nullptr;
+    for (Free *f = g_free; f; prev = f, f = f->next) {
+        if ((char *)f + f->size == end) {
+            if (prev)
+                prev->next = f->next;
+            else
+                g_free = f->next;
+            return (char *)f;
+        }
+    }
+    return end;
+}
+
+} // namespace arena
