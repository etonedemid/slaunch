-static constexpr size_t kHeapSmall = 1u * 1024 * 1024; /* malloc fallback/small heap */
-static constexpr size_t kBigAlloc = 0; /* 0 = route all malloc to arena */
+/* Small blocks stay in malloc's own heap and only 64 KB and up go to the arena.
+   Small long-lived allocations (sol2 statics, SDL per-thread error buffers) made
+   while a menu runs would otherwise land anywhere in the arena and pin its top,
+   so it could not shrink for the browser. */
+static constexpr size_t kHeapSmall = 48u * 1024 * 1024; /* malloc's own heap */
+static constexpr size_t kBigAlloc = 64u * 1024; /* 0 = route all malloc to arena */
 static size_t g_heapSize = 0;
 extern char *fake_heap_start;
 extern char *fake_heap_end;
