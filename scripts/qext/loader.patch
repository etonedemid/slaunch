+/* Same as qext_launch_title for a real title, for a menu that picks the user. */
+extern "C" Result qext_launch_title_as(u64 tid, AccountUid uid)
+{
+    if (!tid)
+        return MAKERESULT(Module_Libnx, LibnxError_BadInput);
+    nro::Disarm();
+    if (app::IsActive()) {
+        Result trc = app::Terminate();
+        if (R_FAILED(trc))
+            logging::LogLine("[qext] terminate-before-launch failed (rc=0x%X), continuing", trc);
+    }
+    Result rc = app::Start(tid, false, uid);
+    if (R_SUCCEEDED(rc)) {
+        titles::NoteLaunched(tid);
+        g_launchedTid = tid;
+    }
+    return rc;
+}
