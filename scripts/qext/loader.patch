+/* Big allocations live apart from malloc's heap, at the top of the heap region.
+   Only the top of the region can go back to the system, and small long-lived
+   allocations made at any time pin everything below them. With these two
+   separated, unloading a menu empties the arena and the whole of it can go,
+   leaving the applet pool the room for large applets. */
+#include "arena_core.h"
+static constexpr size_t kBigAlloc = 64 * 1024;
+static Mutex s_arenaLock;
+static char *s_arenaStart = nullptr;
+static char *s_arenaEnd = nullptr;
+
+static inline bool InArena(void *p)
+{
+    return (char *)p >= s_arenaStart && (char *)p < s_arenaEnd;
+}
+
+static void *ArenaAlloc(size_t n, size_t align)
+{
+    if (n < kBigAlloc || s_arenaEnd == s_arenaStart)
+        return nullptr;
+    mutexLock(&s_arenaLock);
+    void *p = arena::Alloc(n, align);
+    mutexUnlock(&s_arenaLock);
+    return p; /* full: the caller falls back on malloc's heap */
+}
+
+extern "C" {
+
+void *malloc(size_t n)
+{
+    void *p = ArenaAlloc(n, 16);
+    return p ? p : _malloc_r(_REENT, n);
+}
+
+void free(void *p)
+{
+    if (!p)
+        return;
+    if (InArena(p)) {
+        mutexLock(&s_arenaLock);
+        arena::Release(p);
+        mutexUnlock(&s_arenaLock);
+        return;
+    }
+    _free_r(_REENT, p);
+}
+
+void *calloc(size_t a, size_t b)
+{
+    size_t n;
+    if (__builtin_mul_overflow(a, b, &n))
+        return nullptr;
+    void *p = ArenaAlloc(n, 16);
+    if (p) {
+        memset(p, 0, n);
+        return p;
+    }
+    return _calloc_r(_REENT, a, b);
+}
+
+void *memalign(size_t align, size_t n)
+{
+    void *p = ArenaAlloc(n, align);
+    return p ? p : _memalign_r(_REENT, align, n);
+}
+
+void *aligned_alloc(size_t align, size_t n)
+{
+    return memalign(align, n);
+}
+
+int posix_memalign(void **out, size_t align, size_t n)
+{
+    void *p = memalign(align, n);
+    if (!p)
+        return 12; /* ENOMEM */
+    *out = p;
+    return 0;
+}
+
+size_t malloc_usable_size(void *p)
+{
+    if (!p)
+        return 0;
+    return InArena(p) ? arena::Usable(p) : _malloc_usable_size_r(_REENT, p);
+}
+
+void *realloc(void *p, size_t n)
+{
+    if (!p)
+        return malloc(n);
+    if (n == 0) {
+        free(p);
+        return nullptr;
+    }
+    const size_t old = malloc_usable_size(p);
+    if (!InArena(p) && (n < kBigAlloc || s_arenaEnd == s_arenaStart))
+        return _realloc_r(_REENT, p, n);
+    if (InArena(p) && n <= old)
+        return p;
+    void *q = malloc(n);
+    if (!q)
+        return nullptr;
+    memcpy(q, p, old < n ? old : n);
+    free(p);
+    return q;
+}
+
+/* Sets the heap region to total_mb, of which malloc's own heap keeps small_mb and
+   the arena gets the rest. Call again to regrow after qext_heap_release. */
+int qext_heap_setup(unsigned total_mb, unsigned small_mb)
+{
+    size_t total = (size_t)((total_mb + 1) & ~1u) << 20;
+    void *addr = nullptr;
+    Result rc = svcSetHeapSize(&addr, total);
+    if (R_FAILED(rc)) {
+        logging::LogLine("[heap] setup %u MB failed (rc=0x%X)", total_mb, rc);
+        return (int)rc;
+    }
+    g_heapSize = total;
+    mutexLock(&s_arenaLock);
+    if (!s_arenaStart) {
+        size_t small = (size_t)((small_mb + 1) & ~1u) << 20;
+        size_t used = ((size_t)((char *)sbrk(0) - fake_heap_start) + 0x1FFFFFu) & ~(size_t)0x1FFFFFu;
+        if (small < used)
+            small = used;
+        s_arenaStart = s_arenaEnd = fake_heap_start + small;
+        fake_heap_end = s_arenaStart;
+    }
+    char *end = fake_heap_start + total;
+    if (end > s_arenaEnd) {
+        arena::Insert(s_arenaEnd, (size_t)(end - s_arenaEnd));
+        s_arenaEnd = end;
+    }
+    mutexUnlock(&s_arenaLock);
+    logging::LogLine("[heap] %zu MB: malloc %zu, arena %zu", total >> 20,
+                     (size_t)(s_arenaStart - fake_heap_start) >> 20,
+                     (size_t)(s_arenaEnd - s_arenaStart) >> 20);
+    return 0;
+}
+
+unsigned long qext_arena_free_bytes(void)
+{
+    mutexLock(&s_arenaLock);
+    size_t n = arena::FreeBytes();
+    mutexUnlock(&s_arenaLock);
+    return n;
+}
+
+unsigned long qext_arena_size(void)
+{
+    return (unsigned long)(s_arenaEnd - s_arenaStart);
+}
+
+/* Give the arena back, down to its highest live block, so a large applet fits.
+   Lists what is still in there, since anything left is a leak holding it up.
+   Returns the heap size left in MB. */
+unsigned qext_heap_release(FILE *also)
+{
+    mutexLock(&s_arenaLock);
+    for (char *c = s_arenaStart; c < s_arenaEnd; ) {
+        size_t size = *(size_t *)c;
+        if (size < 16 || c + size > s_arenaEnd)
+            break;
+        if (((arena::Head *)c)->magic == arena::kMagic) {
+            char text[33] = {};
+            const char *data = c + sizeof(arena::Head);
+            for (unsigned j = 0; j < 32; j++)
+                text[j] = (data[j] >= 32 && data[j] < 127) ? data[j] : '.';
+            logging::LogLine("[heap] arena live +%zu KB size %zu: %s",
+                             (size_t)(c - s_arenaStart) >> 10, size, text);
+            if (also)
+                fprintf(also, "[heap] arena live +%zu KB size %zu: %s\n",
+                        (size_t)(c - s_arenaStart) >> 10, size, text);
+        }
+        c += size;
+    }
+    char *top = arena::TrimEnd(s_arenaEnd);
+    char *target = fake_heap_start + (((size_t)(top - fake_heap_start) + 0x1FFFFFu) & ~(size_t)0x1FFFFFu);
+    if (target < top || target > s_arenaEnd)
+        target = s_arenaEnd;
+    if (target > top)
+        arena::Insert(top, (size_t)(target - top));
+    void *addr = nullptr;
+    if (target < s_arenaEnd && R_SUCCEEDED(svcSetHeapSize(&addr, (size_t)(target - fake_heap_start)))) {
+        s_arenaEnd = target;
+        g_heapSize = (size_t)(target - fake_heap_start);
+    } else if (target < s_arenaEnd) {
+        arena::Insert(target, (size_t)(s_arenaEnd - target));
+    }
+    mutexUnlock(&s_arenaLock);
+    logging::LogLine("[heap] released to %zu MB", g_heapSize >> 20);
+    return (unsigned)(g_heapSize >> 20);
+}
+
+} /* extern "C" */
