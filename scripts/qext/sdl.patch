+// A BC1 image is block-linear, so the CPU cannot write it: the GPU copies it from a
+// staging block, as part of this frame. That block is freed like a texture, once
+// the frame has run.
+static bool UploadBc1(SWITCH_DEKO3D_RenderData *data, SWITCH_DEKO3D_TextureData *tex, const void *bc1)
+{
+    const uint32_t size = (uint32_t)((tex->w + 3) / 4) * (uint32_t)((tex->h + 3) / 4) * 8;
+    const uint32_t blockSize = (size + 0xFFFu) & ~0xFFFu;
+    SWITCH_DEKO3D_TextureData *staging;
+    DkMemBlockMaker mk;
+    DkImageView view;
+    DkCopyBuf src;
+    DkImageRect rect;
+    if (!StartDrawing(data)) {
+        return false;
+    }
+    staging = (SWITCH_DEKO3D_TextureData *)SDL_calloc(1, sizeof(*staging));
+    if (!staging) {
+        return false;
+    }
+    staging->slot = -1;
+    staging->storage = memalign(DK_MEMBLOCK_ALIGNMENT, blockSize);
+    if (!staging->storage) {
+        SDL_free(staging);
+        return false;
+    }
+    dkMemBlockMakerDefaults(&mk, data->device, blockSize);
+    mk.flags = DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached;
+    mk.storage = staging->storage;
+    staging->mem = data->dk.dkMemBlockCreate(&mk);
+    if (!staging->mem) {
+        free(staging->storage);
+        SDL_free(staging);
+        return false;
+    }
+    SDL_memcpy(data->dk.dkMemBlockGetCpuAddr(staging->mem), bc1, size);
+
+    src.addr = data->dk.dkMemBlockGetGpuAddr(staging->mem);
+    src.rowLength = 0;
+    src.imageHeight = 0;
+    rect.x = rect.y = rect.z = 0;
+    rect.width = (uint32_t)tex->w;
+    rect.height = (uint32_t)tex->h;
+    rect.depth = 1;
+    dkImageViewDefaults(&view, &tex->img);
+    data->dk.dkCmdBufCopyBufferToImage(data->cmdbuf, &src, &view, &rect, 0);
+    // Later draws this frame read it.
+    data->dk.dkCmdBufBarrier(data->cmdbuf, DkBarrier_Full,
+                             DkInvalidateFlags_Image | DkInvalidateFlags_L2Cache);
+
+    staging->nextPending = data->pendingFree;
+    data->pendingFree = staging;
+    return true;
+}
