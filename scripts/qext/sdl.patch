+// Hands a menu the command buffer to draw into with its own shaders, in order with
+// everything SDL has flushed. The caller flushes first; each SDL draw binds all of
+// its own state again, so there is nothing to restore afterwards.
+static DkCmdBuf SWITCH_DEKO3D_BeginExternal(SDL_Renderer *renderer)
+{
+    SWITCH_DEKO3D_RenderData *data = (SWITCH_DEKO3D_RenderData *)renderer->internal;
+    if (!StartDrawing(data)) {
