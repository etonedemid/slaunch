+// A frame with many state changes outruns one block, and without this deko3d
+// aborts the process with DkResult_OutOfMemory.
+static void CmdAddMem(void *userData, DkCmdBuf cmdbuf, size_t minReqSize)
+{
+    SWITCH_DEKO3D_RenderData *data = (SWITCH_DEKO3D_RenderData *)userData;
+    if (data->cmdExtraUsed >= SWITCH_DEKO3D_CMD_EXTRA || minReqSize > SWITCH_DEKO3D_CMD_SIZE) {
+        return; // deko3d reports it
+    }
+    DkMemBlock *block = &data->cmdExtra[data->cmdExtraUsed];
+    if (!*block) {
+        DkMemBlockMaker mk;
+        dkMemBlockMakerDefaults(&mk, data->device, SWITCH_DEKO3D_CMD_SIZE);
+        mk.flags = DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached;
+        *block = data->dk.dkMemBlockCreate(&mk);
+        if (!*block) {
+            return;
+        }
+    }
+    data->cmdExtraUsed++;
+    data->dk.dkCmdBufAddMemory(cmdbuf, *block, 0, SWITCH_DEKO3D_CMD_SIZE);
 }
 
